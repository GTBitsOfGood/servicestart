import { and, eq } from "drizzle-orm";
import db from "@/lib/db";
import { events, eventRsvps } from "@/lib/schema";
import { randomUUID } from "node:crypto";

async function create(
  organizationId: string,
  name: string,
  location: string,
  startTimestamp: Date | null,
  duration: string | null,
  description?: string,
  coverImageUrl?: string,
) {
  const id = randomUUID();

  await db.insert(events).values({
    id,
    organizationId,
    name,
    location,
    description,
    startTimestamp,
    duration,
    coverImageUrl,
  });

  const [event] = await db
    .select({
      id: events.id,
      organizationId: events.organizationId,
      name: events.name,
      location: events.location,
      description: events.description,
      startTimestamp: events.startTimestamp,
      duration: events.duration,
      coverImageUrl: events.coverImageUrl,
    })
    .from(events)
    .where(eq(events.id, id))
    .limit(1);

  return event ?? null;
}

async function deleteById(eventId: string) {
  await db.delete(events).where(eq(events.id, eventId));
}

async function findById(eventId: string) {
  const [event] = await db
    .select({
      id: events.id,
      organizationId: events.organizationId,
      name: events.name,
      location: events.location,
      description: events.description,
      startTimestamp: events.startTimestamp,
      duration: events.duration,
      coverImageUrl: events.coverImageUrl,
    })
    .from(events)
    .where(eq(events.id, eventId))
    .limit(1);

  return event ?? null;
}

async function listByOrganization(
  organizationId: string,
  options: { limit: number; offset: number },
) {
  return await db
    .select({
      id: events.id,
      organizationId: events.organizationId,
      name: events.name,
      location: events.location,
      description: events.description,
      startTimestamp: events.startTimestamp,
      duration: events.duration,
      coverImageUrl: events.coverImageUrl,
    })
    .from(events)
    .where(eq(events.organizationId, organizationId))
    .limit(options.limit)
    .offset(options.offset);
}

async function updateEvent(
  eventId: string,
  updates: {
    name?: string;
    location?: string;
    description?: string;
    startTimestamp?: Date | null;
    duration?: string | null;
    coverImageUrl?: string | null;
  },
) {
  await db.update(events).set(updates).where(eq(events.id, eventId));

  const [updated] = await db
    .select({
      id: events.id,
      organizationId: events.organizationId,
      name: events.name,
      location: events.location,
      description: events.description,
      startTimestamp: events.startTimestamp,
      duration: events.duration,
      coverImageUrl: events.coverImageUrl,
    })
    .from(events)
    .where(eq(events.id, eventId))
    .limit(1);

  return updated ?? null;
}

async function addRSVP(eventId: string, userId: string) {
  await db.insert(eventRsvps).values({
    eventId,
    userId,
  });

  return await findById(eventId);
}

async function removeRSVP(eventId: string, userId: string) {
  await db
    .delete(eventRsvps)
    .where(and(eq(eventRsvps.eventId, eventId), eq(eventRsvps.userId, userId)));

  return await findById(eventId);
}

export const EventService = {
  create,
  deleteById,
  findById,
  listByOrganization,
  updateEvent,
  addRSVP,
  removeRSVP,
};
