# Required: application PostgreSQL connection. Local db:create credentials below.
DB_URL=postgres://dev:root@localhost:5432/postgres
# Required: generate a private value with openssl rand -base64 32.
BETTER_AUTH_SECRET=
# Optional: authentication origin; defaults to the application's base URL.
BETTER_AUTH_URL=http://localhost:3000
# Optional: public application origin; defaults to http://localhost:3000.
NEXT_PUBLIC_BASE_URL=
# Optional: preview database branch substitution; defaults to main.
NEXT_PUBLIC_BRANCH_NAME=
# Optional: production URL used for main-- deployment URLs.
NEXT_PUBLIC_PROD_URL=
# Optional: true or 1 disables client organization-configuration caching.
NEXT_PUBLIC_ORG_CONFIG_CACHE_DISABLED=

# Optional: local (default) or juno file storage.
FILE_SERVICE_IMPLEMENTATION=local
# Required for local file storage: directory relative to the repository root.
FILE_STORAGE_DIR=./storage

# Required for Juno operations: generated by pnpm run juno:setup.
JUNO_API_KEY=
# Required for local Juno setup; optional at runtime (SDK defaults to hosted Juno).
JUNO_BASE_URL=http://localhost:8888
# Required for email: base sender domain, without mail. or a URL scheme.
# This .test domain is ONLY for default local simulation. Use a verified domain for real delivery.
EMAIL_SENDER_DOMAIN=notifications.test
# Required for email setup only. Fake key for local simulation; obtain an approved key for real delivery.
SENDGRID_KEY=test-key

# Required for Juno file storage: project ID from the Juno administrator.
JUNO_PROJECT_ID=
# Required for Juno file storage/provider setup: registered provider name.
FILE_PROVIDER_NAME=servicestart-dev
# Optional: Juno bucket name prefix; defaults to ServiceStart.
JUNO_FILE_BUCKET_PREFIX=ServiceStart
# Required for Azure provider setup and Juno file URL resolution.
AZURE_STORAGE_ACCOUNT_NAME=
# Required only for Azure provider setup: obtain securely from the administrator.
AZURE_STORAGE_ACCOUNT_KEY=
# Required only to register an organization's file bucket through setupOrg.
SETUP_ORGANIZATION_ID=

# Optional: comma-separated additional Next.js development origins.
ALLOWED_DEV_ORIGINS=
# Optional: Playwright target origin; defaults to http://localhost:3000.
BASE_URL=
# Optional: tenant domain override for tests; .env.test uses lvh.me.
E2E_TENANT_DOMAIN=
